# ─── Paseo ────────────────────────────────────────────────────────────────────
# Paseo 데몬이 떠 있는 호스트. docker-compose에서는 서비스 이름(paseo).
PASEO_HOST=localhost
PASEO_PORT=6767
# Paseo 데몬에 비밀번호를 설정했다면 동일한 값을 넣는다.
PASEO_PASSWORD=
# true면 wss://, false면 ws:// 로 접속한다.
USE_TLS=false

# ─── AI Agent ─────────────────────────────────────────────────────────────────
# claude_code | codex
WORKER_AGENT=claude_code
# 비워 두면 provider 기본 모델을 사용한다. 예: claude-opus-5, gpt-5.5
WORKER_MODEL=
# 에이전트 한 턴의 최대 대기 시간(ms). 기본 30분.
AGENT_TIMEOUT_MS=1800000

# ─── Git / Workspace ──────────────────────────────────────────────────────────
# 작업 대상 저장소의 경로. **Paseo 데몬이 보는 기준**의 경로여야 한다.
# (docker 배포에서는 paseo 컨테이너 안의 마운트 경로)
PROJECT_PATH=/workspace/target-repo
# Paseo가 worktree를 분기할 base branch.
BASE_BRANCH=dev
# 이슈별 브랜치 접두사. 결과: issue/123
BRANCH_PREFIX=issue/

# ─── GitHub ───────────────────────────────────────────────────────────────────
# repo 스코프 PAT 또는 GitHub App 설치 토큰.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
# 쉼표 구분. 비우면 모든 open 이슈가 대상이 된다. 예: automate,bug
GITHUB_ISSUE_LABELS=
# GitHub Enterprise Server를 쓸 때만 변경한다.
GITHUB_API_BASE_URL=https://api.github.com

# ─── Issue Source ─────────────────────────────────────────────────────────────
# 이슈를 가져올 소스. 현재 지원: github
ISSUE_SOURCE=github

# ─── Loop ─────────────────────────────────────────────────────────────────────
# 폴링 주기(ms). 한 사이클이 끝난 뒤 이만큼 쉬고 다음 사이클을 시작한다. 기본 10초.
POLL_INTERVAL_MS=10000
# 동시에 처리할 이슈 수. worktree는 이슈마다 따로 생성된다.
MAX_CONCURRENT_ISSUES=1
# 실패한 이슈 재시도 횟수. 초과하면 status=failed로 남는다.
MAX_ATTEMPTS=3

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# docker-compose에서는 postgres 서비스로 덮어쓰므로 Host OS 실행 기준으로 적는다.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=loop
# docker-compose의 postgres 서비스는 이 값이 비어 있으면 기동하지 않는다.
DB_PASSWORD=
DB_NAME=loop
# 스키마 자동 동기화. 운영에서는 false로 두고 마이그레이션을 사용한다.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ─── Runtime ──────────────────────────────────────────────────────────────────
# docker | host
DEPLOYMENT=docker
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# 개발 중 사람이 읽기 좋은 로그가 필요하면 true.
LOG_PRETTY=false
